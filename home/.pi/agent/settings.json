{
  "lastChangelogVersion": "0.84.2",
  "theme": "nord",
  "terminal": {
    "showImages": false
  },
  "hideThinkingBlock": true,
  "quietStartup": true,
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "xhigh",
  "packages": [
    "npm:@petechu/pi-extension-toggle@0.1.3",
    "npm:@pi-kaush/pi-inline-skill-identifier@0.1.1",
    "git:github.com/algal/pi-openai-server-compaction@c6d593087709e9481223dc6c6c2269b371b5e055",
    "npm:@maddeye/pi-nord@1.0.0",
    {
      "source": "npm:@quintinshaw/pi-dynamic-workflows@3.7.0",
      "extensions": [],
      "skills": [],
      "prompts": [],
      "themes": []
    },
    "npm:pi-web-access-lazy@0.1.0",
    "./packages/pi-herdr-btw",
    "npm:@windust/pi-goal@0.4.1"
  ],
  "extensions": [],
  "enabledModels": [
    "openai-codex/gpt-5.6-sol",
    "tcodex/gpt-5.6-sol",
    "codebuddy/kimi-k3-ioa:max",
    "codebuddy/claude-opus-5",
    "tclaude/claude-opus-4-6[1m]",
    "codebuddy/deepseek-v4-flash-ioa",
