{
  "settings": {
    "toolPrefix": "server",
    "idleTimeout": 10,
    "showStatusIcon": false
  },
  "mcpServers": {
    "private-remote": {
      "url": "<private-mcp-url>",
      "headers": {
        "Authorization": "<local-token>"
      },
      "lifecycle": "lazy",
      "idleTimeout": 10,
      "directTools": false
    },
    "local": {
      "url": "http://127.0.0.1:8081/mcp",
      "lifecycle": "lazy",
      "idleTimeout": 10,
      "directTools": false
    }
  }
}
