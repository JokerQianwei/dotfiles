# Herdr 运行时文件会自动生成，不进入仓库
home/.config/herdr/*.log
home/.config/herdr/session.json
home/.config/herdr/*.sock

# macOS 和 Nix 构建文件
.DS_Store
result
result-*

# Pi 凭据和 Home Manager 接管前的备份只保留在本机
/home/.pi/agent/auth.json
/home/.pi/agent/models.json*
/home/.pi/agent/mcp.json
/home/.pi/agent/**/*.backup
/home/.pi/agent/**/*.bak*

# 凭据和机器本地账号状态
/home/.ssh/
/home/.aws/
/home/.config/gh/*
!/home/.config/gh/config.yml
/home/.config/gcloud/
/home/.git-credentials
/home/.netrc
/home/.npmrc
**/.env
**/.env.local
**/*.pem


# no-mistakes 本地验证状态不得提交到公开仓库
.no-mistakes/
